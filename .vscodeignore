.vscode/**
.github/**
.claude/**
.gitignore
node_modules/**
# ...except the engine. DuckDB runs natively in the extension host now, and its binding is
# a Node-API addon plus a platform shared library — so this is the one dependency that has
# to ship inside the vsix. It is also why releases are PLATFORM-SPECIFIC
# (`vsce package --target win32-x64`): npm only installs the optional binding matching the
# machine that packaged it, so a target-less vsix would carry one platform's binary and
# claim to serve all of them.
# (A negation is final in vsce — a later exclude cannot narrow it again, so the binding's
# .d.ts files ship too. ~200KB of text against a 36MB library; not worth a build step.)
!node_modules/@duckdb/**
stage-webview.mjs
fetch-binding.mjs
fetch-extensions.mjs
check-binding.mjs
make-icon.mjs
vendor.mjs
**/*.vsix

# The tracked source of the panel. What ships is webview/ — the staged copy
# stage-webview.mjs builds from it — so packaging app/ too would ship every file twice.
app/**

# The extension's tests: run from the checkout, never shipped.
test/**

