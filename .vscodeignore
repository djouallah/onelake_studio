.vscode/**
.github/**
.claude/**
.gitignore
node_modules/**
# ...except the engine's binding. DuckDB runs natively in the extension host, and its
# binding is a Node-API addon plus a platform shared library — so it is the one dependency
# that has to ship as files inside the vsix (@duckdb/node-api, its JavaScript, is in
# dist/extension.js). It is also why releases are PLATFORM-SPECIFIC
# (`vsce package --target win32-x64`): npm only installs the optional binding matching the
# machine that packaged it, so a target-less vsix would carry one platform's binary and
# claim to serve all of them.
# (A negation is final in vsce — a later exclude cannot narrow it again, so the binding's
# .d.ts files ship too. A few KB against a 36MB library.)
!node_modules/@duckdb/node-bindings/**
!node_modules/@duckdb/node-bindings-*/**

# The extension host's source: what ships is dist/extension.js, which scripts/bundle.mjs
# builds from it. bridge.js is the exception — bin/cli.mjs requires it from outside the
# editor, where the bundle (it needs `vscode`) cannot load.
src/**
!src/bridge.js
# Packaging scripts, run from the checkout.
scripts/**
**/*.vsix

# The tracked source of the panel. What ships is webview/ — the staged copy
# scripts/stage-webview.mjs builds from it — so packaging app/ too would ship every file twice.
app/**

# The extension's tests: run from the checkout, never shipped.
test/**

