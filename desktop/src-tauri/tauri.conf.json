{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneLake Studio",
  "mainBinaryName": "onelake-studio",
  "version": "../../package.json",
  "identifier": "com.onelakestudio.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OneLake Studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": ["app/**/*"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
