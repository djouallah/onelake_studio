# The catalog, listed as standard DuckDB lists it: SHOW, information_schema and the
# duckdb_*() functions. Every table and model the cache knows is there, opened or not, and
# each OneLake schema is named by its whole path (workspace.item_kind.schema), in the engine's
# own database, onelake.

query TTTTTT rowsort
SHOW ALL TABLES
----
onelake	cat1	Sales_semanticmodel	['model']	['VARCHAR']	false
onelake	cat1.lh.dbo	t	['a']	['BIGINT']	false
onelake	cat1.wh_warehouse.sales	e	['id']	['INTEGER']	false
onelake	cat2.lh.dbo	t	['b', 'c']	['VARCHAR', 'DECIMAL(10,2)']	false

query TTT rowsort
SHOW SCHEMAS
----
onelake	cat1	false
onelake	cat1.lh	false
onelake	cat1.lh.dbo	false
onelake	cat1.wh_warehouse	false
onelake	cat1.wh_warehouse.sales	false
onelake	cat2	false
onelake	cat2.lh	false
onelake	cat2.lh.dbo	false
onelake	main	true

query T rowsort
SHOW DATABASES
----
onelake

statement ok
SHOW TABLES

query T
SHOW TABLES FROM cat2.lh.dbo
----
t

# Any case, and quoted parts.
query T
show tables from Cat1."lh".dbo;
----
t

query T
SHOW TABLES FROM onelake.cat2.lh.dbo
----
t

query T
SHOW TABLES FROM onelake.cat1
----
Sales_semanticmodel

# information_schema and duckdb_views() are DuckDB's own: they name only the innermost of
# the nested schemas, so the two workspaces' dbo.t are two rows that look alike.
query TTT
SELECT table_catalog, table_schema, table_name FROM information_schema.tables WHERE table_catalog = 'onelake' AND table_schema <> 'main' ORDER BY ALL
----
onelake	cat1	Sales_semanticmodel
onelake	dbo	t
onelake	dbo	t
onelake	sales	e

query TTTT
SELECT table_catalog, table_name, column_name, data_type FROM information_schema.columns WHERE table_catalog = 'onelake' AND table_schema <> 'main' ORDER BY ALL
----
onelake	Sales_semanticmodel	model	VARCHAR
onelake	e	id	INTEGER
onelake	t	a	BIGINT
onelake	t	b	VARCHAR
onelake	t	c	DECIMAL(10,2)

query TTT
SELECT database_name, schema_name, view_name FROM duckdb_views() WHERE NOT internal ORDER BY ALL
----
onelake	cat1	Sales_semanticmodel
onelake	dbo	t
onelake	dbo	t
onelake	sales	e

query I
SELECT count(*) FROM duckdb_schemas() WHERE database_name = 'onelake' AND schema_name <> 'main'
----
8

statement ok
SELECT count(*) FROM duckdb_tables()

statement ok
SELECT count(*) FROM duckdb_columns()

statement ok
SELECT count(*) FROM duckdb_databases()

statement error
