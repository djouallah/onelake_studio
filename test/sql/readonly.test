# Read only: nothing a statement says can write, to OneLake or anywhere else.

statement error
CREATE TABLE memory.main.x (a INT)
----
Read only

statement error
INSERT INTO lakehouse.cat1.lh.dbo.t VALUES (1)
----
Read only

statement error
DELETE FROM lakehouse.cat1.lh.dbo.t
----
Read only

statement error
COPY (SELECT 1) TO 'x.csv'
----
Read only

statement error
SET enable_external_access = true
----
Read only

statement error
SELECT 1; SELECT 2
----
one statement at a time

# The same, hidden: nothing around a statement changes what it is.
statement error
/* a comment */ COPY (SELECT 1) TO 'x.csv'
----
Read only

statement error
SELECT 1 /* ; */; COPY (SELECT 1) TO 'x.csv'
----
one statement at a time

statement error
SELECT ';'; COPY (SELECT 1) TO 'x.csv'
----
one statement at a time

statement error
SELECT $$;$$; COPY (SELECT 1) TO 'x.csv'
----
one statement at a time

statement error
WITH a AS (SELECT 1) COPY (SELECT 1) TO 'x.csv'
----
Read only

statement error
WITH a AS (SELECT 1) DELETE FROM lakehouse.cat1.lh.dbo.t
----
Read only

statement error
EXPLAIN ANALYZE COPY (SELECT 1) TO 'x.csv'
----
Read only

statement error
CREATE VIEW v AS DELETE FROM lakehouse.cat1.lh.dbo.t
----
Read only

# What changes the engine itself.
statement error
INSTALL httpfs
----
Read only

statement error
LOAD httpfs
----
Read only

statement error
CALL load_aws_credentials()
----
Read only

statement error
SET lock_configuration = false
----
Read only

statement error
ATTACH ':memory:' AS x
----
Read only

# What the page sends to set up its reads is the page's. This is the command line, which reads.
statement error
DROP TABLE memory.main.not_a_table
----
DROP is not a read

statement error
DROP TABLE IF EXISTS lakehouse.cat1.lh.dbo.no_such_table
----
DROP is not a read

statement error
DROP VIEW lakehouse.cat1.lh.dbo.t
----
DROP is not a read

statement error
DROP SCHEMA lakehouse.cat1 CASCADE
----
DROP is not a read

statement error
DETACH lakehouse
----
DETACH is not a read

statement error
CREATE VIEW v AS SELECT 1
----
CREATE is not a read

statement error
CREATE SCHEMA s
----
CREATE is not a read

statement error
ATTACH 'x.db' AS x (READ_ONLY)
----
ATTACH is not a read

# What the read-only check lets through, and the engine's lockdown has to refuse. A read of this
# machine's disk is no read of OneLake, whatever the SQL calls it.
statement error
SELECT * FROM read_text('~/.ssh/id_rsa')

statement error
SELECT * FROM read_csv('/etc/passwd')

statement error
SELECT * FROM read_csv('C:/Windows/win.ini')

statement error
SELECT * FROM glob('/*')

statement error
SELECT getenv('HOME')

statement error
PRAGMA enable_external_access = true

statement error
PRAGMA allowed_directories = ['/']
