# What a statement may not do: write anywhere but a lakehouse, change the engine, or reach the disk.
# A write to a lakehouse is refused here too: this engine has none to write to (writes.test is the rest).

statement error
CREATE TABLE memory.main.x (a INT)
----
Not run

statement error
INSERT INTO cat1.lh_lakehouse.dbo.t VALUES (1)
----
Not run

statement error
DELETE FROM cat1.lh_lakehouse.dbo.t
----
Not run

statement error
COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
SET enable_external_access = true
----
Not run

# Several statements run in turn: the last one's rows are the answer.
query I
SELECT 1; SELECT 2
----
2

# The same, hidden: nothing around a statement changes what it is.
statement error
/* a comment */ COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
SELECT 1 /* ; */; COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
SELECT ';'; COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
SELECT $$;$$; COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
WITH a AS (SELECT 1) COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
WITH a AS (SELECT 1) DELETE FROM cat1.lh_lakehouse.dbo.t
----
Not run

statement error
EXPLAIN ANALYZE COPY (SELECT 1) TO 'x.csv'
----
Not run

statement error
CREATE VIEW v AS DELETE FROM cat1.lh_lakehouse.dbo.t
----
Not run

# What changes the engine itself.
statement error
INSTALL httpfs
----
Not run

statement error
LOAD httpfs
----
Not run

statement error
CALL load_aws_credentials()
----
Not run

statement error
SET lock_configuration = false
----
Not run

statement error
ATTACH ':memory:' AS x
----
Not run

# What the page sends to set up its reads is the page's. DROP is blocked for now, of anything.
statement error
DROP TABLE memory.main.not_a_table
----
DROP is blocked

statement error
DROP TABLE IF EXISTS cat1.lh_lakehouse.dbo.no_such_table
----
DROP is blocked

statement error
DROP VIEW cat1.lh_lakehouse.dbo.t
----
DROP is blocked

statement error
DROP SCHEMA cat1 CASCADE
----
DROP is blocked

statement error
DETACH lakehouse
----
DETACH is not a read

statement error
CREATE VIEW v AS SELECT 1
----
CREATE VIEW isn't a write to a lakehouse

statement error
CREATE SCHEMA s
----
a schema is made in a lakehouse

statement error
ATTACH 'x.db' AS x (READ_ONLY)
----
ATTACH is not a read

# What the read-only check lets through, and the engine's lockdown has to refuse. A read of this
# machine's disk is no read of OneLake, whatever the SQL calls it.
statement error
SELECT * FROM read_text('~/.ssh/id_rsa')

statement error
SELECT * FROM read_csv('/etc/passwd')

statement error
SELECT * FROM read_csv('C:/Windows/win.ini')

statement error
SELECT * FROM glob('/*')

statement error
SELECT getenv('HOME')

statement error
PRAGMA enable_external_access = true

statement error
PRAGMA allowed_directories = ['/']
