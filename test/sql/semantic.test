# Semantic models: workspace.model_semanticmodel, a view in its workspace's schema. SHOW SEMANTIC
# VIEWS lists every one the cache knows; one not opened yet has no file and no tables yet.

query TTTTT
SHOW SEMANTIC VIEWS
----
onelake	cat1	Sales_semanticmodel	NULL	NULL

query TTTTT
show semantic views;
----
onelake	cat1	Sales_semanticmodel	NULL	NULL

statement error
SHOW SEMANTIC VIEW
----
syntax error

# A model has one name: a shorter one is not a model, and DuckDB says so.
statement error
SELECT AGG("x") FROM Sales
----
Sales

statement error
SELECT AGG("x") FROM cat1.Sales
----
Sales

statement error
DESCRIBE cat1.Sales
----
Sales

# Nor is the old one.
statement error
SELECT AGG("x") FROM semanticmodel.cat1.Sales
----
semanticmodel

# A model is never made or dropped in SQL.
statement error
CREATE SEMANTIC VIEW cat1.x FROM 'x.bim'
----
Not run

statement error
DROP SEMANTIC VIEW cat1.Sales_semanticmodel
----
Not run
