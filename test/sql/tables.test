# A table is read by its SQL name, workspace.item_kind.schema.table, whatever is open: the
# engine opens it as the statement names it. Every cached table here is empty.

# A table named where the engine cannot see the name (inside a string) is refused, and
# never answers no rows.
statement error
SELECT * FROM query_table('cat2.lh_lakehouse.dbo.t')
----
Not run

query TT
SELECT column_name, column_type FROM (DESCRIBE cat2.lh_lakehouse.dbo.t)
----
b	VARCHAR
c	DECIMAL(10,2)

query TTTTTT
DESCRIBE cat1.lh_lakehouse.dbo.t
----
a	BIGINT	YES	NULL	NULL	NULL

query I
SELECT count(*) FROM cat1.lh_lakehouse.dbo.t
----
0

# Any case, quoted parts, spaces around the dots.
query I
SELECT count(*) FROM "cat2".lh_lakehouse . DBO."T"
----
0

query I
SELECT count(*) FROM cat1.lh_lakehouse.dbo.t a JOIN cat1.wh_warehouse.sales.e b ON a.a = b.id
----
0

statement ok
SUMMARIZE cat1.wh_warehouse.sales.e

statement ok
EXPLAIN SELECT * FROM cat2.lh_lakehouse.dbo.t

statement error
SELECT * FROM cat1.nothere_lakehouse.dbo.t
