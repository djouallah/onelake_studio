{
  "name": "onelake-studio",
  "displayName": "OneLake Studio",
  "description": "Browse and query Microsoft Fabric OneLake Iceberg tables with DuckDB, signed in with your VS Code Microsoft account.",
  "version": "0.1.2",
  "publisher": "djouallah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djouallah/onelake_studio.git"
  },
  "homepage": "https://github.com/djouallah/onelake_studio#readme",
  "bugs": {
    "url": "https://github.com/djouallah/onelake_studio/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "fabric",
    "onelake",
    "iceberg",
    "duckdb",
    "lakehouse"
  ],
  "main": "./src/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "OneLake Studio never reads or executes workspace files; everything it touches lives in OneLake and its own storage."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "onelakeStudio.open",
        "title": "Open OneLake Studio",
        "category": "OneLake Studio",
        "icon": "$(window)"
      },
      {
        "command": "onelakeStudio.switchAccount",
        "title": "Switch Microsoft Account",
        "category": "OneLake Studio",
        "icon": "$(account)"
      },
      {
        "command": "onelakeStudio.signIn",
        "title": "Sign in to OneLake",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.refresh",
        "title": "Refresh",
        "category": "OneLake Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "onelakeStudio.showLog",
        "title": "Show Read Log",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.clearCache",
        "title": "Clear Cached OneLake Data",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openTable",
        "title": "Open Table",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openFile",
        "title": "Open File",
        "category": "OneLake Studio"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onelakeStudio",
          "title": "OneLake Studio",
          "icon": "media/onelake.svg"
        }
      ]
    },
    "views": {
      "onelakeStudio": [
        {
          "id": "onelakeStudio.explorer",
          "name": "OneLake"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onelakeStudio.explorer",
        "when": "!onelakeStudio.signedIn",
        "contents": "Browse and query OneLake Iceberg tables with DuckDB, signed in with the Microsoft account VS Code already holds — you register nothing.\n[Sign in to OneLake](command:onelakeStudio.signIn)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "onelakeStudio.open",
          "when": "view == onelakeStudio.explorer",
          "group": "navigation@2"
        },
        {
          "command": "onelakeStudio.switchAccount",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account"
        }
      ],
      "view/item/context": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(workspace|item|dir|tables|error)$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "onelakeStudio.openTable",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openFile",
          "when": "false"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "!onelakeStudio.signedIn"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "onelakeStudio.signedIn"
        }
      ]
    },
    "configuration": {
      "title": "OneLake Studio",
      "properties": {
        "onelakeStudio.tenantId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "patternErrorMessage": "A directory (tenant) ID is a GUID, e.g. 72f988bf-86f1-41af-91ab-2d7cd011db47.",
          "markdownDescription": "Directory (tenant) GUID to sign in against. Leave empty for your home tenant; set it to reach a tenant you are a guest in. Machine-scoped on purpose: a setting that steers *authentication* must not be overridable by a workspace's own `.vscode/settings.json`."
        },
        "onelakeStudio.dataCacheGB": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "Disk to spend caching OneLake data, in GB. Iceberg data files and manifests are kept until evicted — a new snapshot writes new files, so a cached one can never be stale. Reading a table you have opened before comes off disk instead of the network. Set to `0` to cache nothing; `OneLake Studio: Clear Cached OneLake Data` empties it and reports what it freed. Applies after the window is reloaded."
        },
        "onelakeStudio.catalogTtlMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "scope": "machine",
          "markdownDescription": "How old a catalog answer, listing or other mutable object may be before it is refreshed. The last-known answer is ALWAYS served instantly from disk — a table you have ever opened opens without waiting on the catalog; once the answer is older than this, a background refresh fetches the current one, so a new snapshot shows up one click later. `0` disables the caching and asks OneLake every time. Applies after the window is reloaded."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./check-binding.mjs && node ./copy-site.mjs && node ./vendor.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1"
  }
}
