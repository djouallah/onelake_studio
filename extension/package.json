{
  "name": "onelake-studio",
  "displayName": "OneLake Studio",
  "description": "Browse and query Microsoft Fabric OneLake Iceberg tables with DuckDB, signed in with your VS Code Microsoft account.",
  "version": "0.1.1",
  "publisher": "djouallah",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/djouallah/onelake_studio.git" },
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Data Science", "Visualization", "Other"],
  "keywords": ["fabric", "onelake", "iceberg", "duckdb", "lakehouse"],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "onelakeStudio.open",
        "title": "Open OneLake Studio",
        "category": "OneLake Studio",
        "icon": "$(window)"
      },
      {
        "command": "onelakeStudio.switchAccount",
        "title": "Switch Microsoft Account",
        "category": "OneLake Studio",
        "icon": "$(account)"
      },
      {
        "command": "onelakeStudio.signIn",
        "title": "Sign in to OneLake",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.refresh",
        "title": "Refresh",
        "category": "OneLake Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "onelakeStudio.showLog",
        "title": "Show Read Log",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.clearCache",
        "title": "Clear Cached OneLake Data",
        "category": "OneLake Studio"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onelakeStudio",
          "title": "OneLake Studio",
          "icon": "media/onelake.svg"
        }
      ]
    },
    "views": {
      "onelakeStudio": [
        { "id": "onelakeStudio.explorer", "name": "OneLake" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onelakeStudio.explorer",
        "when": "!onelakeStudio.signedIn",
        "contents": "Browse and query OneLake Iceberg tables with DuckDB, signed in with the Microsoft account VS Code already holds — you register nothing.\n[Sign in to OneLake](command:onelakeStudio.signIn)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "onelakeStudio.open",
          "when": "view == onelakeStudio.explorer",
          "group": "navigation@2"
        },
        {
          "command": "onelakeStudio.switchAccount",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account"
        }
      ],
      "view/item/context": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(workspace|item|dir)$/",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "OneLake Studio",
      "properties": {
        "onelakeStudio.tenantId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Directory (tenant) GUID to sign in against. Leave empty for your home tenant; set it to reach a tenant you are a guest in."
        },
        "onelakeStudio.dataCacheGB": {
          "type": "number",
          "default": 20,
          "minimum": 0,
          "markdownDescription": "Disk to spend caching OneLake data, in GB. Only Iceberg data files and manifests are cached — objects a new snapshot replaces rather than rewrites, so a cached one can never be stale. Reading a table you have opened before comes off disk instead of the network. Set to `0` to cache nothing; `OneLake Studio: Clear Cached OneLake Data` empties it and reports what it freed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node ./copy-site.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
