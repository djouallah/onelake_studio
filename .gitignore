node_modules/
*.log
.DS_Store
*.duckdb
webview/
*.vsix
# The engine, downloaded by vendor.mjs at package time (and once per checkout
# for F5). Pinned, reproducible artifacts — ~40MB that has no business in git history.
vendor/
# DuckDB extension binaries for one platform, fetched by fetch-extensions.mjs at
# package time.
duckdb-extensions/
# The extension host bundled by scripts/bundle.mjs (at package time, and by F5).
dist/
# Export to Fabric's function, as its deploy package: built by function-bundle.mjs at
# package time from the template vendor.mjs fetched, and shipped in the vsix.
fabric-function/
fabric_app/**/node_modules/
# Screenshots and drafts for blog posts, kept out of the repo.
blog/
