      "activitybar": [
        {
          "id": "onelakeStudio",
          "title": "OneLake Studio",
          "icon": "media/onelake.svg"
        }
      ]
    },
    "views": {
      "onelakeStudio": [
        {
          "id": "onelakeStudio.explorer",
          "name": "OneLake Studio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onelakeStudio.explorer",
        "when": "!onelakeStudio.signedIn",
        "contents": "Browse OneLake, signed in with the Microsoft account VS Code already holds — you register nothing.\n[Sign in to OneLake](command:onelakeStudio.signIn)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onelakeStudio.goTo",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@0"
        },
        {
          "command": "onelakeStudio.filterTree",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "0_view@1"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn && !onelakeStudio.hasSession",
          "group": "1_account@0"
        },
        {
          "command": "onelakeStudio.switchAccount",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account@1"
        },
        {
          "command": "onelakeStudio.signOut",
          "when": "view == onelakeStudio.explorer && onelakeStudio.hasSession",
          "group": "1_account@2"
        },
        {
          "command": "onelakeStudio.openSettings",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account@3"
        },
        {
          "command": "onelakeStudio.clearCache",
          "when": "view == onelakeStudio.explorer",
          "group": "2_cache"
        }
      ],
      "view/item/context": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(workspace|workspacePinned|item|dir|tables|models|apps|error)$/",
          "group": "inline@3"
        },
        {
          "command": "onelakeStudio.pinWorkspace",
          "when": "view == onelakeStudio.explorer && viewItem == workspace",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.unpinWorkspace",
          "when": "view == onelakeStudio.explorer && viewItem == workspacePinned",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.redownloadSemanticModel",
          "when": "view == onelakeStudio.explorer && viewItem == semanticModel",
          "group": "inline@3"
        },
        {
          "command": "onelakeStudio.copyAppUrl",
          "when": "view == onelakeStudio.explorer && viewItem == fabricAppUrl",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(table|file|dir|semanticModel)$/",
          "group": "inline@2"
        },
        {
          "command": "onelakeStudio.selectTop",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "0_query@1"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "1_copy@1"
        },
        {
          "command": "onelakeStudio.copyColumns",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "1_copy@2"
        },
        {
          "command": "onelakeStudio.downloadFile",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(file|semanticModel)$/",
          "group": "inline@1"
        },
        {
          "command": "onelakeStudio.uploadFiles",
          "when": "view == onelakeStudio.explorer && viewItem == dir",
          "group": "inline@1"
        },
        {
          "command": "onelakeStudio.newQuery",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.newQuery",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "1_edit@1"
        },
        {
          "command": "onelakeStudio.revealQueries",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "1_edit@2"
        },
        {
          "command": "onelakeStudio.renameQuery",
          "when": "view == onelakeStudio.explorer && viewItem == query",
          "group": "1_edit@1"
        },
        {
          "command": "onelakeStudio.deleteQuery",
          "when": "view == onelakeStudio.explorer && viewItem == query",
          "group": "1_edit@2"
        }
      ],
      "webview/context": [
        {
          "command": "onelakeStudio.gridCopy",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@1"
        },
        {
          "command": "onelakeStudio.gridCopyHeaders",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@2"
        },
        {
          "command": "onelakeStudio.gridCopyCsv",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@3"
        },
        {
          "command": "onelakeStudio.gridCopyMarkdown",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@4"
        },
        {
          "command": "onelakeStudio.gridCopyJson",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@5"
        },
        {
          "command": "onelakeStudio.gridOpenCsv",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "2_open@1"
        },
        {
          "command": "onelakeStudio.gridOpenJson",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "2_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "onelakeStudio.downloadFile",
          "when": "false"
        },
        {
          "command": "onelakeStudio.uploadFiles",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridOpenCsv",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridOpenJson",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopy",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyHeaders",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyCsv",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyMarkdown",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyJson",
          "when": "false"
        },
        {
          "command": "onelakeStudio.filterTree",
          "when": "onelakeStudio.signedIn"
        },
        {
          "command": "onelakeStudio.openTable",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openFile",
          "when": "false"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "!onelakeStudio.hasSession"
        },
        {
          "command": "onelakeStudio.signOut",
          "when": "onelakeStudio.hasSession"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "onelakeStudio.signedIn"
        },
        {
          "command": "onelakeStudio.signInFabric",
          "when": "false"
        },
        {
          "command": "onelakeStudio.pinWorkspace",
          "when": "false"
        },
        {
          "command": "onelakeStudio.unpinWorkspace",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openSemanticModel",
          "when": "false"
        },
        {
          "command": "onelakeStudio.redownloadSemanticModel",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copyAppUrl",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openApp",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "false"
        },
        {
          "command": "onelakeStudio.selectTop",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copyColumns",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openQuery",
          "when": "false"
        },
        {
          "command": "onelakeStudio.renameQuery",
          "when": "false"
        },
        {
          "command": "onelakeStudio.deleteQuery",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Cache",
        "order": 1,
        "properties": {
          "onelakeStudio.catalogTtlMinutes": {
            "type": "number",
            "default": 5,
            "minimum": 0,
            "scope": "machine",
            "order": 1,
            "markdownDescription": "How old a listing (workspaces, items, tables, Files/) may be before it is refreshed. The last-known answer is ALWAYS served instantly from disk; once it is older than this, a background refresh fetches the current one and the tree redraws if it changed. `0` refreshes behind every read. **Refresh** in the tree re-reads in the foreground. A table's own metadata has its own window, `tableMetadataTtlHours`."
          },
          "onelakeStudio.tableMetadataTtlHours": {
            "type": "number",
            "default": 24,
            "minimum": 0,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "How old a table's Iceberg metadata (its snapshot, schema and stats, from the catalog's slowest call) may be before it is refreshed, in hours. A table you have opened before opens from disk without asking the catalog; past this age it is refreshed behind you and a new snapshot shows one open later. **Refresh** on its lakehouse (or the whole tree) re-reads it at once."
          },
          "onelakeStudio.keepUsedTablesGB": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "A table statements keep reading (3 times in 14 days) is kept up to date, and a new snapshot of it is read whole in the background when nothing else is running, so it works offline, every column. This is how much may be kept that way, and may come down in a day, and it is never more than half of `#onelakeStudio.diskCacheMaxGB#`. A bigger table is not downloaded. `0` turns the download off, and its metadata is still kept up to date."
          },
          "onelakeStudio.prefetchMetadata": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "When a lakehouse's **Tables** node is opened, read each table's Iceberg metadata in the background (two at a time, skipping what is already cached), so the first click on a table is a disk read rather than a wait on the Iceberg catalog — which can take seconds per table. Turn off to read a table's metadata only when it is clicked."
          },
          "onelakeStudio.diskCacheMaxGB": {
            "type": "number",
            "default": 64,
            "minimum": 0,
            "scope": "machine",
            "order": 4,
            "markdownDescription": "How much of what DuckDB reads from OneLake (table data, manifests, metadata and `Files/` objects) is kept on disk, in GB, so what was read once is read from this machine afterwards, even after a restart. A kept copy is checked against OneLake first, so a rewritten file is read again. `0` turns the disk cache off. Kept per Microsoft account. The oldest is dropped past this size only when the engine starts, so a long session can go over it. **Clear Cached OneLake Data** empties it. Applies the next time the engine starts."
          },
          "onelakeStudio.cacheDirectory": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 5,
            "pattern": "^$|^([A-Za-z]:)?[\\\\/]",
            "patternErrorMessage": "A full path, e.g. D:\\OneLakeCache or /data/onelake-cache.",
            "markdownDescription": "Where the disk cache is kept, as a full path, for a bigger disk than the one VS Code stores its data on. Empty is VS Code's storage for this extension. A new folder starts empty; you are asked whether to delete the old one. Listings and table metadata stay in VS Code's storage. Applies the next time the engine starts."
          },
          "onelakeStudio.engineThreads": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "How many threads DuckDB may use. Lower it to keep cores free for VS Code during a heavy query. `0` is DuckDB's default, every core. Applies the next time the engine starts."
          },
          "onelakeStudio.engineSpillMaxGB": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "How much a query bigger than memory may spill to the temp folder, in GB. A query that needs more fails. `0` is DuckDB's default. Applies the next time the engine starts."
          },
          "onelakeStudio.logMaxGB": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "scope": "machine",
            "order": 4,
            "markdownDescription": "How much of what the engine ran is kept for **Logs**, in GB, per account. It holds your SQL and its errors. Past this the oldest go. `0` keeps none. Applies the next time the engine starts."
          }
        }
      },
      {
        "title": "Query and Results",
        "order": 3,
        "properties": {
          "onelakeStudio.selectTopRows": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "order": 2,
            "markdownDescription": "How many rows **Select Top Rows** asks for."
          },
          "onelakeStudio.maxResultRows": {
            "type": "integer",
            "default": 200000,
            "minimum": 1000,
            "maximum": 1000000,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "The most rows of one result a tab and the command line keep. Past it, rows are only counted. **Export…** always writes every row. More rows use more memory in the extension host and the tab. Applies the next time the engine starts."
          },
          "onelakeStudio.sqlEngine": {
            "type": "string",
            "enum": [
              "duckdb",
              "sqlEndpoint"
            ],
            "enumDescriptions": [
              "DuckDB on this machine, from what it reads of OneLake and keeps. Works offline.",
              "The Fabric SQL endpoint of the workspace a statement names: the SQL box takes T-SQL, and a semantic model's queries are compiled to T-SQL. Offline, DuckDB runs them."
            ],
            "default": "duckdb",
            "order": 4,
            "markdownDescription": "What runs the SQL box's statements and a semantic model's queries (Explore, Pivot, Open in Excel, the command line). With **sqlEndpoint**, write T-SQL and name tables as everywhere else, `lakehouse.<workspace>.<item>.<schema>.<table>`: each statement runs on that workspace's SQL endpoint. A table's Stats, Data and files are always read by DuckDB."
          },
          "onelakeStudio.tableOpensOn": {
            "type": "string",
            "enum": [
              "stats",
              "data"
            ],
            "enumDescriptions": [
              "Stats, from the table's metadata. No table data is read.",
              "Data, the table's first rows."
            ],
            "default": "stats",
            "order": 4,
            "markdownDescription": "What clicking a table shows first."
          },
          "onelakeStudio.gridThousandsSeparator": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Show numbers in the results grid with thousands separators, e.g. `1,234,567.89`. A copy still gets the raw value."
          }
        }
      },
      {
        "title": "Sign-in",
        "order": 4,
        "properties": {
          "onelakeStudio.tenantId": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "patternErrorMessage": "A directory (tenant) ID is a GUID, e.g. 72f988bf-86f1-41af-91ab-2d7cd011db47.",
            "markdownDescription": "Directory (tenant) GUID to sign in against. Leave empty for your home tenant; set it to reach a tenant you are a guest in. Machine-scoped on purpose: a setting that steers *authentication* must not be overridable by a workspace's own `.vscode/settings.json`."
          }
        }
      }
    ]
  },
