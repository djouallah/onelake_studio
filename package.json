{
  "name": "onelake-studio",
  "displayName": "OneLake Studio",
  "description": "Browse and explore your Microsoft Fabric data in VS Code: OneLake tables and files, semantic models in a pivot, and one-click Fabric apps.",
  "version": "0.2.9",
  "publisher": "djouallah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djouallah/onelake_studio.git"
  },
  "homepage": "https://github.com/djouallah/onelake_studio#readme",
  "bugs": {
    "url": "https://github.com/djouallah/onelake_studio/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "fabric",
    "onelake",
    "iceberg",
    "duckdb",
    "lakehouse",
    "power bi",
    "semantic model"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "OneLake Studio never reads or executes workspace files; everything it touches lives in OneLake and its own storage."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "onelakeStudio.open",
        "title": "Open OneLake Studio",
        "category": "OneLake Studio",
        "icon": "$(window)"
      },
      {
        "command": "onelakeStudio.switchAccount",
        "title": "Switch Microsoft Account",
        "category": "OneLake Studio",
        "icon": "$(account)"
      },
      {
        "command": "onelakeStudio.openSettings",
        "title": "Settings",
        "category": "OneLake Studio",
        "icon": "$(gear)"
      },
      {
        "command": "onelakeStudio.signIn",
        "title": "Sign in to OneLake",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.signOut",
        "title": "Sign Out",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.refresh",
        "title": "Refresh",
        "category": "OneLake Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "onelakeStudio.showLog",
        "title": "Show Read Log",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.groupByType",
        "title": "Group by Type",
        "category": "OneLake Studio",
        "icon": "$(list-tree)"
      },
      {
        "command": "onelakeStudio.ungroupByType",
        "title": "Group by Workspace",
        "category": "OneLake Studio",
        "icon": "$(list-flat)"
      },
      {
        "command": "onelakeStudio.installClaudeSkill",
        "title": "Install Agent Skill (Claude Code, GitHub Copilot)",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.clearCache",
        "title": "Clear Cached OneLake Data",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openTable",
        "title": "Open Table",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openFile",
        "title": "Open File",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.signInFabric",
        "title": "Sign in to the Fabric API",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.pinWorkspace",
        "title": "Pin to Favorites",
        "category": "OneLake Studio",
        "icon": "$(star-empty)"
      },
      {
        "command": "onelakeStudio.unpinWorkspace",
        "title": "Unpin from Favorites",
        "category": "OneLake Studio",
        "icon": "$(star-full)"
      },
      {
        "command": "onelakeStudio.openSemanticModel",
        "title": "Open Semantic Model",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.redownloadSemanticModel",
        "title": "Download Again (from Fabric)",
        "category": "OneLake Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "onelakeStudio.copyAppUrl",
        "title": "Copy App URL",
        "category": "OneLake Studio",
        "icon": "$(copy)"
      },
      {
        "command": "onelakeStudio.selectTop",
        "title": "Select Top Rows",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.copyColumns",
        "title": "Copy Column List",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.copySqlName",
        "title": "Copy SQL Name",
        "category": "OneLake Studio",
        "icon": "$(copy)"
      },
      {
        "command": "onelakeStudio.openQuery",
        "title": "Open Query",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.renameQuery",
        "title": "Rename Query…",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.deleteQuery",
        "title": "Delete Query",
        "category": "OneLake Studio",
        "icon": "$(trash)"
      },
      {
        "command": "onelakeStudio.revealQueries",
        "title": "Show Queries Folder",
        "category": "OneLake Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "onelakeStudio.newQuery",
        "title": "New Query",
        "category": "OneLake Studio",
        "icon": "$(add)"
      },
      {
        "command": "onelakeStudio.goTo",
        "title": "Go to a Table, Column or Measure…",
        "category": "OneLake Studio",
        "icon": "$(search)"
      },
      {
        "command": "onelakeStudio.clearVariables",
        "title": "Clear Query Variables",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.runQuery",
        "title": "OneLake Run",
        "category": "OneLake Studio",
        "icon": "$(play)"
      },
      {
        "command": "onelakeStudio.planQuery",
        "title": "OneLake Plan",
        "category": "OneLake Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "onelakeStudio.saveQuery",
        "title": "OneLake Save Query",
        "category": "OneLake Studio",
        "icon": "$(save)"
      },
      {
        "command": "onelakeStudio.gridCopy",
        "title": "Copy",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyHeaders",
        "title": "Copy with Headers",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyCsv",
        "title": "Copy as CSV",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyMarkdown",
        "title": "Copy as Markdown",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyJson",
        "title": "Copy as JSON",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridOpenCsv",
        "title": "Open as CSV Document",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridOpenJson",
        "title": "Open as JSON Document",
        "category": "OneLake Studio"
      }
    ],
    "keybindings": [
      {
        "command": "onelakeStudio.goTo",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "onelakeStudio.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i"
      },
      {
        "command": "onelakeStudio.saveQuery",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "editorTextFocus && resourceScheme == untitled && resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onelakeStudio",
          "title": "OneLake Studio",
          "icon": "media/onelake.svg"
        }
      ]
    },
    "views": {
      "onelakeStudio": [
        {
          "id": "onelakeStudio.explorer",
          "name": "OneLake Studio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onelakeStudio.explorer",
        "when": "!onelakeStudio.signedIn",
        "contents": "Browse OneLake, signed in with the Microsoft account VS Code already holds — you register nothing.\n[Sign in to OneLake](command:onelakeStudio.signIn)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onelakeStudio.groupByType",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn && !onelakeStudio.groupedByType",
          "group": "0_view@0"
        },
        {
          "command": "onelakeStudio.ungroupByType",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn && onelakeStudio.groupedByType",
          "group": "0_view@0"
        },
        {
          "command": "onelakeStudio.goTo",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@0"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "0_view@1"
        },
        {
          "command": "onelakeStudio.open",
          "when": "view == onelakeStudio.explorer",
          "group": "0_view@2"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn && !onelakeStudio.hasSession",
          "group": "1_account@0"
        },
        {
          "command": "onelakeStudio.switchAccount",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account@1"
        },
        {
          "command": "onelakeStudio.signOut",
          "when": "view == onelakeStudio.explorer && onelakeStudio.hasSession",
          "group": "1_account@2"
        },
        {
          "command": "onelakeStudio.openSettings",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account@3"
        },
        {
          "command": "onelakeStudio.clearCache",
          "when": "view == onelakeStudio.explorer",
          "group": "2_cache"
        }
      ],
      "view/item/context": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(workspace|workspacePinned|item|dir|tables|models|apps|error)$/",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.pinWorkspace",
          "when": "view == onelakeStudio.explorer && viewItem == workspace",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.unpinWorkspace",
          "when": "view == onelakeStudio.explorer && viewItem == workspacePinned",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.redownloadSemanticModel",
          "when": "view == onelakeStudio.explorer && viewItem == semanticModel",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.copyAppUrl",
          "when": "view == onelakeStudio.explorer && viewItem == fabricAppUrl",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.selectTop",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "0_query@1"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "1_copy@1"
        },
        {
          "command": "onelakeStudio.copyColumns",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "1_copy@2"
        },
        {
          "command": "onelakeStudio.newQuery",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.newQuery",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "1_edit@1"
        },
        {
          "command": "onelakeStudio.revealQueries",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "1_edit@2"
        },
        {
          "command": "onelakeStudio.renameQuery",
          "when": "view == onelakeStudio.explorer && viewItem == query",
          "group": "1_edit@1"
        },
        {
          "command": "onelakeStudio.deleteQuery",
          "when": "view == onelakeStudio.explorer && viewItem == query",
          "group": "1_edit@2"
        }
      ],
      "webview/context": [
        {
          "command": "onelakeStudio.gridCopy",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@1"
        },
        {
          "command": "onelakeStudio.gridCopyHeaders",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@2"
        },
        {
          "command": "onelakeStudio.gridCopyCsv",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@3"
        },
        {
          "command": "onelakeStudio.gridCopyMarkdown",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@4"
        },
        {
          "command": "onelakeStudio.gridCopyJson",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@5"
        },
        {
          "command": "onelakeStudio.gridOpenCsv",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "2_open@1"
        },
        {
          "command": "onelakeStudio.gridOpenJson",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "2_open@2"
        }
      ],
      "editor/title": [
        {
          "command": "onelakeStudio.runQuery",
          "when": "resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i",
          "group": "navigation@1"
        },
        {
          "command": "onelakeStudio.planQuery",
          "when": "resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i",
          "group": "navigation@2"
        },
        {
          "command": "onelakeStudio.saveQuery",
          "when": "resourceScheme == untitled && resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "onelakeStudio.gridOpenCsv",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridOpenJson",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopy",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyHeaders",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyCsv",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyMarkdown",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyJson",
          "when": "false"
        },
        {
          "command": "onelakeStudio.runQuery",
          "when": "resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i"
        },
        {
          "command": "onelakeStudio.planQuery",
          "when": "resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i"
        },
        {
          "command": "onelakeStudio.saveQuery",
          "when": "resourcePath =~ /[\\\\\\/]OneLakeStudio[\\\\\\/]queries[\\\\\\/]/i"
        },
        {
          "command": "onelakeStudio.groupByType",
          "when": "onelakeStudio.signedIn && !onelakeStudio.groupedByType"
        },
        {
          "command": "onelakeStudio.ungroupByType",
          "when": "onelakeStudio.signedIn && onelakeStudio.groupedByType"
        },
        {
          "command": "onelakeStudio.openTable",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openFile",
          "when": "false"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "!onelakeStudio.hasSession"
        },
        {
          "command": "onelakeStudio.signOut",
          "when": "onelakeStudio.hasSession"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "onelakeStudio.signedIn"
        },
        {
          "command": "onelakeStudio.signInFabric",
          "when": "false"
        },
        {
          "command": "onelakeStudio.pinWorkspace",
          "when": "false"
        },
        {
          "command": "onelakeStudio.unpinWorkspace",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openSemanticModel",
          "when": "false"
        },
        {
          "command": "onelakeStudio.redownloadSemanticModel",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copyAppUrl",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "false"
        },
        {
          "command": "onelakeStudio.selectTop",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copyColumns",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openQuery",
          "when": "false"
        },
        {
          "command": "onelakeStudio.renameQuery",
          "when": "false"
        },
        {
          "command": "onelakeStudio.deleteQuery",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Cache",
        "order": 1,
        "properties": {
          "onelakeStudio.catalogTtlMinutes": {
            "type": "number",
            "default": 5,
            "minimum": 0,
            "scope": "machine",
            "order": 1,
            "markdownDescription": "How old a listing (workspaces, items, tables, Files/) may be before it is refreshed. The last-known answer is ALWAYS served instantly from disk; once it is older than this, a background refresh fetches the current one and the tree redraws if it changed. `0` refreshes behind every read. **Refresh** in the tree re-reads in the foreground. A table's own metadata has its own window, `tableMetadataTtlHours`."
          },
          "onelakeStudio.tableMetadataTtlHours": {
            "type": "number",
            "default": 24,
            "minimum": 0,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "How old a table's Iceberg metadata (its snapshot, schema and stats, from the catalog's slowest call) may be before it is refreshed, in hours. A table you have opened before opens from disk without asking the catalog; past this age it is refreshed behind you and a new snapshot shows one open later. **Refresh** on its lakehouse (or the whole tree) re-reads it at once."
          },
          "onelakeStudio.prefetchMetadata": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "When a lakehouse's **Tables** node is opened, read each table's Iceberg metadata in the background (two at a time, skipping what is already cached), so the first click on a table is a disk read rather than a wait on the Iceberg catalog — which can take seconds per table. Turn off to read a table's metadata only when it is clicked."
          },
          "onelakeStudio.diskCacheMaxGB": {
            "type": "number",
            "default": 64,
            "minimum": 0,
            "scope": "machine",
            "order": 4,
            "markdownDescription": "How much of what DuckDB reads from OneLake (table data, manifests, metadata and `Files/` objects) is kept on disk, in GB, so what was read once is read from this machine afterwards, even after a restart. A kept copy is checked against OneLake first, so a rewritten file is read again. `0` turns the disk cache off. Kept per Microsoft account. The oldest is dropped past this size only when the engine starts, so a long session can go over it. **Clear Cached OneLake Data** empties it. Applies the next time the engine starts."
          },
          "onelakeStudio.cacheDirectory": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 5,
            "pattern": "^$|^([A-Za-z]:)?[\\\\/]",
            "patternErrorMessage": "A full path, e.g. D:\\OneLakeCache or /data/onelake-cache.",
            "markdownDescription": "Where the disk cache is kept, as a full path, for a bigger disk than the one VS Code stores its data on. Empty is VS Code's storage for this extension. A new folder starts empty; you are asked whether to delete the old one. Listings and table metadata stay in VS Code's storage. Applies the next time the engine starts."
          },
          "onelakeStudio.metadataCacheMaxMB": {
            "type": "number",
            "default": 256,
            "minimum": 1,
            "scope": "machine",
            "order": 6,
            "markdownDescription": "How much of the listings, table metadata and first rows is kept on disk, in MB, per Microsoft account. The oldest is dropped past this size. Only a very large tenant should need more."
          }
        }
      },
      {
        "title": "Engine",
        "order": 2,
        "properties": {
          "onelakeStudio.engineMemoryLimit": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 1,
            "pattern": "^$|^\\d+(\\.\\d+)?\\s*(KB|MB|GB|TB|KiB|MiB|GiB|TiB)$",
            "patternErrorMessage": "A DuckDB memory size, e.g. 4GB or 512MB.",
            "markdownDescription": "Most memory DuckDB may use, e.g. `4GB`. Empty means a quarter of this machine's RAM — DuckDB's own default is 80%, which is too much for the extension host every other extension shares. Bigger queries spill to a temp directory instead of failing. Applies the next time the engine starts."
          },
          "onelakeStudio.engineThreads": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "How many threads DuckDB may use. Lower it to keep cores free for VS Code during a heavy query. `0` is DuckDB's default, every core. Applies the next time the engine starts."
          },
          "onelakeStudio.engineSpillMaxGB": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "How much a query bigger than memory may spill to the temp folder, in GB. A query that needs more fails. `0` is DuckDB's default. Applies the next time the engine starts."
          }
        }
      },
      {
        "title": "Query and Results",
        "order": 3,
        "properties": {
          "onelakeStudio.resultsLocation": {
            "type": "string",
            "enum": ["below", "beside"],
            "enumDescriptions": [
              "Under the query's editor, in a group of its own.",
              "Beside the query's editor, side by side."
            ],
            "default": "below",
            "order": 1,
            "markdownDescription": "Where a query's results show when it is run from its editor. The panel moves only when it would cover the editor; once it is in a group of its own, it stays wherever you put it."
          },
          "onelakeStudio.selectTopRows": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "order": 2,
            "markdownDescription": "How many rows **Select Top Rows** asks for."
          },
          "onelakeStudio.maxResultRows": {
            "type": "integer",
            "default": 200000,
            "minimum": 1000,
            "maximum": 1000000,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "The most rows of one result the panel and the command line keep. Past it, rows are only counted. **Export…** always writes every row. More rows use more memory in the extension host and the panel. Applies the next time the engine starts."
          },
          "onelakeStudio.tableOpensOn": {
            "type": "string",
            "enum": ["stats", "data"],
            "enumDescriptions": [
              "Stats, from the table's metadata. No table data is read.",
              "Data, the table's first rows."
            ],
            "default": "stats",
            "order": 4,
            "markdownDescription": "What clicking a table shows first."
          },
          "onelakeStudio.gridThousandsSeparator": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Show numbers in the results grid with thousands separators, e.g. `1,234,567.89`. A copy still gets the raw value."
          }
        }
      },
      {
        "title": "Sign-in",
        "order": 4,
        "properties": {
          "onelakeStudio.tenantId": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "patternErrorMessage": "A directory (tenant) ID is a GUID, e.g. 72f988bf-86f1-41af-91ab-2d7cd011db47.",
            "markdownDescription": "Directory (tenant) GUID to sign in against. Leave empty for your home tenant; set it to reach a tenant you are a guest in. Machine-scoped on purpose: a setting that steers *authentication* must not be overridable by a workspace's own `.vscode/settings.json`."
          }
        }
      }
    ]
