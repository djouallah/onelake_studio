{
  "name": "onelake-studio",
  "displayName": "OneLake Studio",
  "description": "Browse and explore your Microsoft Fabric data in VS Code: OneLake tables and files, semantic models in a pivot, and one-click Fabric apps.",
  "version": "0.2.22",
  "publisher": "djouallah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djouallah/onelake_studio.git"
  },
  "homepage": "https://djouallah.github.io/onelake_studio/",
  "bugs": {
    "url": "https://github.com/djouallah/onelake_studio/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "fabric",
    "onelake",
    "iceberg",
    "duckdb",
    "lakehouse",
    "power bi",
    "semantic model"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "OneLake Studio runs nothing from the workspace. The one thing it touches there is Export to Fabric's local copy of an app: one zip it wrote itself, after an OK, which the Report tab reads."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "onelakeStudio.fabricApp",
        "displayName": "OneLake Studio app",
        "selector": [{ "filenamePattern": "*.fabricapp" }],
        "priority": "default"
      },
      {
        "viewType": "onelakeStudio.ossieModel",
        "displayName": "OneLake Studio model",
        "selector": [{ "filenamePattern": "*.ossie.yaml" }],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "onelakeStudio.open",
        "title": "Open OneLake Studio",
        "category": "OneLake Studio",
        "icon": "$(window)"
      },
      {
        "command": "onelakeStudio.switchAccount",
        "title": "Switch Microsoft Account",
        "category": "OneLake Studio",
        "icon": "$(account)"
      },
      {
        "command": "onelakeStudio.openSettings",
        "title": "Settings",
        "category": "OneLake Studio",
        "icon": "$(gear)"
      },
      {
        "command": "onelakeStudio.showPerformance",
        "title": "Performance",
        "category": "OneLake Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "onelakeStudio.showLogs",
        "title": "Logs",
        "category": "OneLake Studio",
        "icon": "$(history)"
      },
      {
        "command": "onelakeStudio.signIn",
        "title": "Sign in to OneLake",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.signOut",
        "title": "Sign Out",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.refresh",
        "title": "Refresh",
        "category": "OneLake Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "onelakeStudio.showLog",
        "title": "Show Read Log",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.installClaudeSkill",
        "title": "Install Agent Skill (Claude Code, GitHub Copilot)",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.clearCache",
        "title": "Clear Cached OneLake Data",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openTable",
        "title": "Open Table",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openFile",
        "title": "Open File",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.signInFabric",
        "title": "Sign in to the Fabric API",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.pinWorkspace",
        "title": "Pin to Favorites",
        "category": "OneLake Studio",
        "icon": "$(star-empty)"
      },
      {
        "command": "onelakeStudio.unpinWorkspace",
        "title": "Unpin from Favorites",
        "category": "OneLake Studio",
        "icon": "$(star-full)"
      },
      {
        "command": "onelakeStudio.openSemanticModel",
        "title": "Open Semantic Model",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openPath",
        "title": "Open in OneLake Studio",
        "category": "OneLake Studio",
        "icon": "$(open-preview)"
      },
      {
        "command": "onelakeStudio.createSemanticModel",
        "title": "Create Semantic Model…",
        "category": "OneLake Studio",
        "icon": "$(database)"
      },      {
        "command": "onelakeStudio.downloadFile",
        "title": "Download File…",
        "category": "OneLake Studio",
        "icon": "$(desktop-download)"
      },
      {
        "command": "onelakeStudio.uploadFiles",
        "title": "Upload Files…",
        "category": "OneLake Studio",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "onelakeStudio.copyAppUrl",
        "title": "Copy App URL",
        "category": "OneLake Studio",
        "icon": "$(copy)"
      },
      {
        "command": "onelakeStudio.openApp",
        "title": "Open App",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.selectTop",
        "title": "Select Top Rows",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.tableHealth",
        "title": "Table Health",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.downloadTables",
        "title": "Download Tables for Offline",
        "category": "OneLake Studio",
        "icon": "$(cloud-download)"
      },
      {
        "command": "onelakeStudio.copyColumns",
        "title": "Copy Column List",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.copySqlName",
        "title": "Copy SQL Name",
        "category": "OneLake Studio",
        "icon": "$(copy)"
      },
      {
        "command": "onelakeStudio.openQuery",
        "title": "Open Query",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.openInternalTable",
        "title": "Open system_internal Table",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.renameQuery",
        "title": "Rename Query…",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.deleteQuery",
        "title": "Delete Query",
        "category": "OneLake Studio",
        "icon": "$(trash)"
      },
      {
        "command": "onelakeStudio.revealQueries",
        "title": "Show Queries Folder",
        "category": "OneLake Studio",
        "icon": "$(folder-opened)"
      },
      {
        "command": "onelakeStudio.newQuery",
        "title": "New Query",
        "category": "OneLake Studio",
        "icon": "$(add)"
      },
      {
        "command": "onelakeStudio.goTo",
        "title": "Go to a Table, Column or Measure…",
        "category": "OneLake Studio",
        "icon": "$(search)"
      },
      {
        "command": "onelakeStudio.filterTree",
        "title": "Filter by Type…",
        "category": "OneLake Studio",
        "icon": "$(filter)"
      },
      {
        "command": "onelakeStudio.clearVariables",
        "title": "Clear Query Variables",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopy",
        "title": "Copy",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyHeaders",
        "title": "Copy with Headers",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyCsv",
        "title": "Copy as CSV",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyMarkdown",
        "title": "Copy as Markdown",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridCopyJson",
        "title": "Copy as JSON",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridOpenCsv",
        "title": "Open as CSV Document",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.gridOpenJson",
        "title": "Open as JSON Document",
        "category": "OneLake Studio"
      }
    ],
    "keybindings": [
      {
        "command": "onelakeStudio.goTo",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onelakeStudio",
          "title": "OneLake Studio",
          "icon": "media/onelake.svg"
        }
      ]
    },
    "views": {
      "onelakeStudio": [
        {
          "id": "onelakeStudio.explorer",
          "name": "OneLake Studio"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "onelakeStudio.explorer",
        "when": "!onelakeStudio.signedIn",
        "contents": "Browse OneLake, signed in with the Microsoft account VS Code already holds — you register nothing.\n[Sign in to OneLake](command:onelakeStudio.signIn)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "onelakeStudio.openPath",
          "when": "resourceScheme == file && resourcePath in onelakeStudio.modelPaths",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "onelakeStudio.openPath",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(ya?ml|bim|fabricapp)$/i",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "onelakeStudio.goTo",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@0"
        },
        {
          "command": "onelakeStudio.filterTree",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn",
          "group": "0_view@1"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "view == onelakeStudio.explorer && onelakeStudio.signedIn && !onelakeStudio.hasSession",
          "group": "1_account@0"
        },
        {
          "command": "onelakeStudio.switchAccount",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account@1"
        },
        {
          "command": "onelakeStudio.signOut",
          "when": "view == onelakeStudio.explorer && onelakeStudio.hasSession",
          "group": "1_account@2"
        },
        {
          "command": "onelakeStudio.openSettings",
          "when": "view == onelakeStudio.explorer",
          "group": "1_account@3"
        },
        {
          "command": "onelakeStudio.clearCache",
          "when": "view == onelakeStudio.explorer",
          "group": "2_cache"
        }
      ],
      "view/item/context": [
        {
          "command": "onelakeStudio.refresh",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(workspace|workspacePinned|item|dir|tables|models|apps|error)$/",
          "group": "inline@3"
        },
        {
          "command": "onelakeStudio.pinWorkspace",
          "when": "view == onelakeStudio.explorer && viewItem == workspace",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.unpinWorkspace",
          "when": "view == onelakeStudio.explorer && viewItem == workspacePinned",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.copyAppUrl",
          "when": "view == onelakeStudio.explorer && viewItem == fabricAppUrl",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(table|file|modelFile|dir|semanticModel)$/",
          "group": "inline@2"
        },
        {
          "command": "onelakeStudio.selectTop",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "0_query@1"
        },
        {
          "command": "onelakeStudio.tableHealth",
          "when": "view == onelakeStudio.explorer && viewItem == item",
          "group": "0_query@2"
        },
        {
          "command": "onelakeStudio.downloadTables",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(item|schema)$/",
          "group": "inline@2"
        },
        {
          "command": "onelakeStudio.downloadTables",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(item|schema)$/",
          "group": "0_query@3"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "1_copy@1"
        },
        {
          "command": "onelakeStudio.copyColumns",
          "when": "view == onelakeStudio.explorer && viewItem == table",
          "group": "1_copy@2"
        },
        {
          "command": "onelakeStudio.downloadFile",
          "when": "view == onelakeStudio.explorer && viewItem =~ /^(file|modelFile|semanticModel)$/",
          "group": "inline@1"
        },
        {
          "command": "onelakeStudio.createSemanticModel",
          "when": "view == onelakeStudio.explorer && viewItem == modelFile",
          "group": "inline@0"
        },
        {
          "command": "onelakeStudio.uploadFiles",
          "when": "view == onelakeStudio.explorer && viewItem == dir",
          "group": "inline@1"
        },
        {
          "command": "onelakeStudio.newQuery",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "inline"
        },
        {
          "command": "onelakeStudio.newQuery",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "1_edit@1"
        },
        {
          "command": "onelakeStudio.revealQueries",
          "when": "view == onelakeStudio.explorer && viewItem == queries",
          "group": "1_edit@2"
        },
        {
          "command": "onelakeStudio.renameQuery",
          "when": "view == onelakeStudio.explorer && viewItem == query",
          "group": "1_edit@1"
        },
        {
          "command": "onelakeStudio.deleteQuery",
          "when": "view == onelakeStudio.explorer && viewItem == query",
          "group": "1_edit@2"
        }
      ],
      "webview/context": [
        {
          "command": "onelakeStudio.gridCopy",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@1"
        },
        {
          "command": "onelakeStudio.gridCopyHeaders",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@2"
        },
        {
          "command": "onelakeStudio.gridCopyCsv",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@3"
        },
        {
          "command": "onelakeStudio.gridCopyMarkdown",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@4"
        },
        {
          "command": "onelakeStudio.gridCopyJson",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "1_copy@5"
        },
        {
          "command": "onelakeStudio.gridOpenCsv",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "2_open@1"
        },
        {
          "command": "onelakeStudio.gridOpenJson",
          "when": "webviewId == 'onelakeStudio' && webviewSection == 'grid'",
          "group": "2_open@2"
        }
      ],
      "commandPalette": [
        {
          "command": "onelakeStudio.openPath",
          "when": "false"
        },
        {
          "command": "onelakeStudio.downloadFile",
          "when": "false"
        },
        {
          "command": "onelakeStudio.createSemanticModel",
          "when": "false"
        },
        {
          "command": "onelakeStudio.uploadFiles",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridOpenCsv",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridOpenJson",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopy",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyHeaders",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyCsv",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyMarkdown",
          "when": "false"
        },
        {
          "command": "onelakeStudio.gridCopyJson",
          "when": "false"
        },
        {
          "command": "onelakeStudio.filterTree",
          "when": "onelakeStudio.signedIn"
        },
        {
          "command": "onelakeStudio.openTable",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openFile",
          "when": "false"
        },
        {
          "command": "onelakeStudio.signIn",
          "when": "!onelakeStudio.hasSession"
        },
        {
          "command": "onelakeStudio.signOut",
          "when": "onelakeStudio.hasSession"
        },
        {
          "command": "onelakeStudio.refresh",
          "when": "onelakeStudio.signedIn"
        },
        {
          "command": "onelakeStudio.signInFabric",
          "when": "false"
        },
        {
          "command": "onelakeStudio.pinWorkspace",
          "when": "false"
        },
        {
          "command": "onelakeStudio.unpinWorkspace",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openSemanticModel",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copyAppUrl",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openApp",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copySqlName",
          "when": "false"
        },
        {
          "command": "onelakeStudio.selectTop",
          "when": "false"
        },
        {
          "command": "onelakeStudio.tableHealth",
          "when": "false"
        },
        {
          "command": "onelakeStudio.downloadTables",
          "when": "false"
        },
        {
          "command": "onelakeStudio.copyColumns",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openQuery",
          "when": "false"
        },
        {
          "command": "onelakeStudio.openInternalTable",
          "when": "false"
        },
        {
          "command": "onelakeStudio.renameQuery",
          "when": "false"
        },
        {
          "command": "onelakeStudio.deleteQuery",
          "when": "false"
        }
      ]
    },
    "configuration": [
      {
        "title": "Engine",
        "order": 0,
        "properties": {
          "onelakeStudio.engineMemoryLimit": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 1,
            "pattern": "^$|^\\d+(\\.\\d+)?\\s*(KB|MB|GB|TB|KiB|MiB|GiB|TiB)$",
            "patternErrorMessage": "A DuckDB memory size, e.g. 4GB or 512MB.",
            "markdownDescription": "Most memory DuckDB may use, e.g. `4GB`. Empty is DuckDB's default, 80% of this machine's RAM. Bigger queries spill to a temp directory instead of failing. Applies the next time the engine starts."
          },
          "onelakeStudio.engineThreads": {
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "How many threads DuckDB may use. Lower it to keep cores free for VS Code during a heavy query. `0` is DuckDB's default, every core. Applies the next time the engine starts."
          },
          "onelakeStudio.engineSpillMaxGB": {
            "type": "number",
            "default": 0,
            "minimum": 0,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "How much a query bigger than memory may spill to the temp folder, in GB. A query that needs more fails. `0` is DuckDB's default. Applies the next time the engine starts."
          },
          "onelakeStudio.logMaxGB": {
            "type": "number",
            "default": 1,
            "minimum": 0,
            "scope": "machine",
            "order": 4,
            "markdownDescription": "How much of what the engine ran is kept for **Logs**, in GB, per account. It holds your SQL and its errors. Past this the oldest go. `0` keeps none. Applies the next time the engine starts."
          }
        }
      },
      {
        "title": "Cache",
        "order": 1,
        "properties": {
          "onelakeStudio.catalogTtlMinutes": {
            "type": "number",
            "default": 5,
            "minimum": 0,
            "scope": "machine",
            "order": 1,
            "markdownDescription": "How old a listing (workspaces, items, tables, Files/) may be before it is refreshed. The last-known answer is ALWAYS served instantly from disk; once it is older than this, a background refresh fetches the current one and the tree redraws if it changed. `0` refreshes behind every read. **Refresh** in the tree re-reads in the foreground. A table's own metadata has its own window, `tableMetadataTtlHours`."
          },
          "onelakeStudio.tableMetadataTtlHours": {
            "type": "number",
            "default": 24,
            "minimum": 0,
            "scope": "machine",
            "order": 2,
            "markdownDescription": "How old a table's Iceberg metadata (its snapshot, schema and stats, from the catalog's slowest call) may be before it is refreshed, in hours. A table you have opened before opens from disk without asking the catalog; past this age it is refreshed behind you and a new snapshot shows one open later. **Refresh** on its lakehouse (or the whole tree) re-reads it at once."
          },
          "onelakeStudio.keepUsedTablesGB": {
            "type": "number",
            "default": 10,
            "minimum": 0,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "A table statements keep reading (3 times in 14 days) is kept up to date, and a new snapshot of it is read whole in the background when nothing else is running, so it works offline, every column. This is how much may be kept that way, and may come down in a day, and it is never more than half of `#onelakeStudio.diskCacheMaxGB#`. A bigger table is not downloaded. `0` turns the download off, and its metadata is still kept up to date."
          },
          "onelakeStudio.securedTableRead": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "A table with OneLake security, whose files OneLake refuses you, is read through OneLake's table read API instead: you get the rows and columns your roles allow. Each read uses the workspace's capacity, for every row you may see, so it is kept on disk and read again only past `#onelakeStudio.tableMetadataTtlHours#` or after **Refresh**. Turn off to have such a table fail instead."
          },
          "onelakeStudio.prefetchMetadata": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "When a lakehouse's **Tables** node is opened, read each table's Iceberg metadata in the background (two at a time, skipping what is already cached), so the first click on a table is a disk read rather than a wait on the Iceberg catalog — which can take seconds per table. Turn off to read a table's metadata only when it is clicked."
          },
          "onelakeStudio.diskCacheMaxGB": {
            "type": "number",
            "default": 256,
            "minimum": 0,
            "scope": "machine",
            "order": 4,
            "markdownDescription": "How much of the OneLake tables' files is kept on this machine, in GB, per Microsoft account. A file a query opens comes down whole, and is read from here after, even with no connection. Past this size the least recently read go. A file no snapshot names any more goes on its own. `0` keeps none: every table is read from OneLake. **Clear Cached OneLake Data** empties it. Applies the next time the engine starts."
          },
          "onelakeStudio.cacheDirectory": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "order": 5,
            "pattern": "^$|^([A-Za-z]:)?[\\\\/]",
            "patternErrorMessage": "A full path, e.g. D:\\OneLakeCache or /data/onelake-cache.",
            "markdownDescription": "Where the disk cache is kept, as a full path, for a bigger disk than the one VS Code stores its data on. Empty is VS Code's storage for this extension. A new folder starts empty; you are asked whether to delete the old one. Listings and table metadata stay in VS Code's storage. Applies the next time the engine starts."
          }
        }
      },
      {
        "title": "Query and Results",
        "order": 3,
        "properties": {
          "onelakeStudio.selectTopRows": {
            "type": "integer",
            "default": 1000,
            "minimum": 1,
            "order": 2,
            "markdownDescription": "How many rows a table's first look reads: **Select Top Rows**, the **Data** tab, and the query a table puts in the box. Never more than **Max Result Rows**."
          },
          "onelakeStudio.maxResultRows": {
            "type": "integer",
            "default": 200000,
            "minimum": 1000,
            "maximum": 1000000,
            "scope": "machine",
            "order": 3,
            "markdownDescription": "The most rows of one result a tab and the command line keep, and the most a Visual, a pivot or a Report tile asks for. Past it, rows are only counted. **Export…** always writes every row. More rows use more memory in the extension host and the tab. Applies the next time the engine starts."
          },
          "onelakeStudio.tableOpensOn": {
            "type": "string",
            "enum": [
              "stats",
              "data"
            ],
            "enumDescriptions": [
              "Stats, from the table's metadata. No table data is read.",
              "Data, the table's first rows."
            ],
            "default": "stats",
            "order": 4,
            "markdownDescription": "What clicking a table shows first."
          },
          "onelakeStudio.gridThousandsSeparator": {
            "type": "boolean",
            "default": false,
            "order": 5,
            "markdownDescription": "Show numbers in the results grid with thousands separators, e.g. `1,234,567.89`. A copy still gets the raw value."
          }
        }
      },
      {
        "title": "Sign-in",
        "order": 4,
        "properties": {
          "onelakeStudio.tenantId": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "patternErrorMessage": "A directory (tenant) ID is a GUID, e.g. 72f988bf-86f1-41af-91ab-2d7cd011db47.",
            "markdownDescription": "Directory (tenant) GUID to sign in against. Leave empty for your home tenant; set it to reach a tenant you are a guest in. Machine-scoped on purpose: a setting that steers *authentication* must not be overridable by a workspace's own `.vscode/settings.json`."
          }
        }
      }
    ]
  },
