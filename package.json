{
  "name": "onelake-studio",
  "displayName": "OneLake Studio",
  "description": "Browse and explore your Microsoft Fabric data in VS Code: OneLake tables and files, semantic models in a pivot, and one-click Fabric apps.",
  "version": "0.2.15",
  "publisher": "djouallah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djouallah/onelake_studio.git"
  },
  "homepage": "https://djouallah.github.io/onelake_studio/",
  "bugs": {
    "url": "https://github.com/djouallah/onelake_studio/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "fabric",
    "onelake",
    "iceberg",
    "duckdb",
    "lakehouse",
    "power bi",
    "semantic model"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "OneLake Studio runs nothing from the workspace. The one thing it touches there is Export to Fabric's local copy of an app, after an OK, in a folder it wrote itself."
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "onelakeStudio.open",
        "title": "Open OneLake Studio",
        "category": "OneLake Studio",
        "icon": "$(window)"
      },
      {
        "command": "onelakeStudio.switchAccount",
        "title": "Switch Microsoft Account",
        "category": "OneLake Studio",
        "icon": "$(account)"
      },
      {
        "command": "onelakeStudio.openSettings",
        "title": "Settings",
        "category": "OneLake Studio",
        "icon": "$(gear)"
      },
      {
        "command": "onelakeStudio.showPerformance",
        "title": "Performance",
        "category": "OneLake Studio",
        "icon": "$(pulse)"
      },
      {
        "command": "onelakeStudio.showLogs",
        "title": "Logs",
        "category": "OneLake Studio",
        "icon": "$(history)"
      },
      {
        "command": "onelakeStudio.signIn",
        "title": "Sign in to OneLake",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.signOut",
        "title": "Sign Out",
        "category": "OneLake Studio"
      },
      {
        "command": "onelakeStudio.refresh",
        "title": "Refresh",
        "category": "OneLake Studio",
        "icon": "$(refresh)"
      },
      {
